# Slack app credentials (see app-manifest.yml for the app config to import)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Where the SQLite database file is stored
DB_PATH=./data/bot.sqlite3

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info

# How often (ms) the scheduler checks for due prompts/reminders. Keep <= 60000
# so per-minute send times stay accurate.
TICK_INTERVAL_MS=60000

# GitHub module. Authenticates as a GitHub App with "Issues: read & write",
# installed on the repos you want to file into. Without an app id and private key
# the module stays disabled and the bot ignores @-mentions.
GITHUB_APP_ID=123456

# The app's private key. Either point at the .pem you downloaded...
GITHUB_APP_PRIVATE_KEY_PATH=./data/github-app.private-key.pem
# ...or inline it here instead (PEM with \n escapes, or base64-encoded PEM).
#GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...

# Optional: pin to one installation. Left unset, the installation covering each
# repo is looked up automatically, which is what you want for multi-org apps.
#GITHUB_APP_INSTALLATION_ID=12345678

# Repo used when a mention doesn't name one, e.g. "@bot Fix the login redirect".
GITHUB_DEFAULT_REPO=owner/repo

# Only needed for GitHub Enterprise Server, e.g. https://github.example.com/api/v3
#GITHUB_API_BASE_URL=https://api.github.com
