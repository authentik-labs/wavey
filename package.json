{
  "name": "wavey",
  "version": "0.1.0",
  "description": "Modular Slack bot. Runs daily standups and files GitHub issues from threads.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/request-error": "^7.1.1",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^5.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "luxon": "^3.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yargs-parser": "^22.0.0"
  },
  "devDependencies": {
    "@slack/types": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/yargs-parser": "^21.0.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
