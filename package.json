{
  "name": "wavey",
  "version": "0.1.0",
  "description": "Modular Slack bot. Runs daily standups and files GitHub issues from threads.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/request-error": "^7.1.1",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^3.22.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "luxon": "^3.5.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "yargs-parser": "^22.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/yargs-parser": "^21.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
